{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{.venv/**,node_modules/**,.next/**,tests/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
